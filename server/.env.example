# DeepGuard AI Server Configuration
PORT=5000

# MongoDB Connection String
# Local MongoDB:
MONGODB_URI=mongodb://127.0.0.1:27017/deepguard

# Or MongoDB Atlas Cloud:
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/deepguard?retryWrites=true&w=majority

NODE_ENV=development
CLIENT_URL=http://localhost:5173
